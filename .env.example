# Example only; these variables are not loaded automatically from .env.
# DEVFLOW_WORKSPACE accepts a directory or a .code-workspace file.
DEVFLOW_WORKSPACE=/home/user/code
# Use the OS path-list separator (Windows: semicolon, Unix: colon).
# Include both the directory containing workspace files and referenced project roots.
DEVFLOW_ALLOWED_ROOTS=/home/user/code:/home/user/workspaces
# Optional stable bearer token for MCP clients; unset = random token per backend run.
# DEVFLOW_API_TOKEN=replace-with-a-long-random-secret
# Java uses DEVFLOW_JAVA_HOME, then JAVA_HOME, then java from PATH.
# DEVFLOW_JAVA_HOME=D:\DevelopmentTools\JDK\jdk-17.0.2
# Maven uses MAVEN_HOME/M2_HOME or locates mvn in PATH; no shell is invoked.
# MAVEN_HOME=D:\DevelopmentTools\Maven\apache-maven-3.9.8
# Official Arthas bootstrap, default: .devflow/tools/arthas-boot.jar
# DEVFLOW_ARTHAS_BOOT=D:\tools\arthas-boot.jar
# Windows native NIO socket directory, default: .devflow/sockets
# DEVFLOW_JAVA_SOCKET_DIR=D:\Temp\devflow-sockets
