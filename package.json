{
  "name": "devflow-monorepo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "node scripts/prepare-ripgrep.cjs",
    "tools:prepare": "node scripts/prepare-ripgrep.cjs",
    "web:dev": "pnpm --filter @devflow/web dev",
    "web:build": "pnpm --filter @devflow/web build",
    "web:check": "pnpm --filter @devflow/web typecheck"
  },
  "devDependencies": {
    "@vscode/ripgrep": "1.18.0"
  }
}
